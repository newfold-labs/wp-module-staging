#. translators: %s: must-use plugin directory or file name.
#: includes/StagingBootstrapCheck.php:374
#, php-format
msgid "The must-use plugin \"%s\" caused a fatal error while loading WordPress. Remove it from mu-plugins, then try again."
msgstr "Le plugin indispensable « %s » a provoqué une erreur fatale lors du chargement de WordPress. Supprime-le des mu-plugins, puis réessaie."

#. translators: %s: must-use plugin directory or file name.
#: includes/StagingBootstrapCheck.php:334
#, php-format
msgid "The must-use plugin \"%s\" has a code conflict (Cannot redeclare). Remove it from mu-plugins, then try again."
msgstr "Le plugin incontournable « %s » présente un conflit de code (impossible de redéclarer). Supprime-le des mu-plugins, puis réessaie."

#. translators: %s: must-use plugin directory or file name.
#: includes/StagingBootstrapCheck.php:295
#, php-format
msgid "The must-use plugin \"%s\" is not compatible with PHP 8 because it uses create_function(), which was removed. Remove it from mu-plugins, then try again."
msgstr "Le plugin indispensable « %s » n’est pas compatible avec PHP 8 car il utilise create_function(), qui a été supprimé. Retirez-le des multiples plugins, puis réessayez."

#. translators: %s: plugin directory name.
#: includes/StagingBootstrapCheck.php:381
#, php-format
msgid "The plugin \"%s\" caused a fatal error while loading WordPress. Deactivate it, or deactivate third-party plugins and switch to a default theme such as Twenty Twenty-Five, then try again."
msgstr "Le plugin « %s » a provoqué une erreur fatale lors du chargement de WordPress. Désactivez-le, ou désactivez les plugins tiers et passez à un thème par défaut comme Twenty Twenty-Five, puis réessayez."

#. translators: %s: plugin directory name.
#: includes/StagingBootstrapCheck.php:342
#, php-format
msgid "The plugin \"%s\" has a code conflict (Cannot redeclare). Deactivate it, then try again."
msgstr "Le plugin « %s » présente un conflit de code (impossible de redéclarer). Désactivez-le, puis réessayez."

#. translators: %s: plugin directory name.
#: includes/StagingBootstrapCheck.php:302
#, php-format
msgid "The plugin \"%s\" is not compatible with PHP 8 because it uses create_function(), which was removed. Deactivate it, then try again."
msgstr "Le plugin « %s » n’est pas compatible avec PHP 8 car il utilise create_function(), qui a été supprimé. Désactivez-le, puis réessayez."

#. translators: 1: plugin or theme that declared the symbol first, 2: plugin or theme that declared it again.
#: includes/StagingBootstrapCheck.php:317
#, php-format
msgid "The plugin or theme \"%1$s\" conflicts with \"%2$s\" (Cannot redeclare). Deactivate or remove one of them, then try again."
msgstr "Le plugin ou thème « %1$s » entre en conflit avec « %2$s » (impossible de redéclarer). Désactivez ou supprimez l’un d’eux, puis réessayez."

#: includes/Staging.php:1141
msgid "The staging operation did not complete, please get in touch with our support."
msgstr "L’opération de mise en scène n’a pas été terminée, veuillez contacter notre support."

#. translators: %s: theme directory name.
#: includes/StagingBootstrapCheck.php:366
#, php-format
msgid "The theme \"%s\" caused a fatal error while loading WordPress. Deactivate it, or deactivate third-party plugins and switch to a default theme such as Twenty Twenty-Five, then try again."
msgstr "Le thème « %s » a provoqué une erreur fatale lors du chargement de WordPress. Désactivez-le, ou désactivez les plugins tiers et passez à un thème par défaut comme Twenty Twenty-Five, puis réessayez."

#. translators: %s: theme directory name.
#: includes/StagingBootstrapCheck.php:326
#, php-format
msgid "The theme \"%s\" has a code conflict (Cannot redeclare). Deactivate it, then try again."
msgstr "Le thème « %s » présente un conflit de code (impossible de redéclarer). Désactivez-le, puis réessayez."

#. translators: %s: theme directory name.
#: includes/StagingBootstrapCheck.php:287
