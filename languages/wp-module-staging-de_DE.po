msgid "The deployment is still running. Please wait and check again shortly."
msgstr "Die Bereitstellung läuft noch. Bitte warten Sie und prüfen Sie bald erneut."

#: includes/Staging.php:736
msgid "The deployment stopped before it completed. Please try again."
msgstr "Die Bereitstellung wurde gestoppt, bevor sie abgeschlossen war. Bitte versuchen Sie es erneut."

