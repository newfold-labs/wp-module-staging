msgstr "No se puede ejecutar el script (error de permisos)."

#: includes/Staging.php:1117
msgid "Unable to initialize WP Filesystem."
msgstr "No se puede inicializar el sistema de archivos WP."

#: includes/Staging.php:1140
msgid "Unable to store the staging authentication token. A persistent object cache may be out of sync with the database, or the database is not accepting writes."
msgstr "No se puede almacenar el token de autenticación por etapas. Una caché persistente de objetos puede estar desincronizada con la base de datos, o la base de datos no está aceptando escrituras."

