#. translators: %s: must-use plugin directory or file name.
#: includes/StagingBootstrapCheck.php:374
#, php-format
msgid "The must-use plugin \"%s\" caused a fatal error while loading WordPress. Remove it from mu-plugins, then try again."
msgstr "O plugin obrigatório \"%s\" causou um erro fatal ao carregar o WordPress. Remova do múltiplo plugins e tente novamente."

#. translators: %s: must-use plugin directory or file name.
#: includes/StagingBootstrapCheck.php:334
#, php-format
msgid "The must-use plugin \"%s\" has a code conflict (Cannot redeclare). Remove it from mu-plugins, then try again."
msgstr "O plugin obrigatório \"%s\" tem um conflito de código (Não é possível redeclarar). Remova do mu-plugins e tente novamente."

#. translators: %s: must-use plugin directory or file name.
#: includes/StagingBootstrapCheck.php:295
#, php-format
msgid "The must-use plugin \"%s\" is not compatible with PHP 8 because it uses create_function(), which was removed. Remove it from mu-plugins, then try again."
msgstr "O plugin indispensável \"%s\" não é compatível com PHP 8 porque usa create_function(), que foi removido. Remova dos múltiplos plugins e tente novamente."

#. translators: %s: plugin directory name.
#: includes/StagingBootstrapCheck.php:381
#, php-format
msgid "The plugin \"%s\" caused a fatal error while loading WordPress. Deactivate it, or deactivate third-party plugins and switch to a default theme such as Twenty Twenty-Five, then try again."
msgstr "O plugin \"%s\" causou um erro fatal ao carregar o WordPress. Desative-o, ou desative plugins de terceiros e mude para um tema padrão como Twenty Twenty-Five, então tente novamente."

#. translators: %s: plugin directory name.
#: includes/StagingBootstrapCheck.php:342
#, php-format
msgid "The plugin \"%s\" has a code conflict (Cannot redeclare). Deactivate it, then try again."
msgstr "O plugin \"%s\" tem um conflito de código (Não é possível redeclarar). Desative e tente novamente."

#. translators: %s: plugin directory name.
#: includes/StagingBootstrapCheck.php:302
#, php-format
msgid "The plugin \"%s\" is not compatible with PHP 8 because it uses create_function(), which was removed. Deactivate it, then try again."
msgstr "O plugin \"%s\" não é compatível com PHP 8 porque usa create_function(), que foi removido. Desligue-o e tente novamente."

#. translators: 1: plugin or theme that declared the symbol first, 2: plugin or theme that declared it again.
#: includes/StagingBootstrapCheck.php:317
#, php-format
msgid "The plugin or theme \"%1$s\" conflicts with \"%2$s\" (Cannot redeclare). Deactivate or remove one of them, then try again."
msgstr "O plugin ou tema \"%1$s\" entra em conflito com \"%2$s\" (Não é possível redeclarar). Desative ou remova um deles, então tente novamente."

#: includes/Staging.php:1468
msgid "The staging operation did not complete, please get in touch with our support."
msgstr "A operação de preparação não foi concluída, por favor, entre em contato com nosso suporte."

#. translators: %s: theme directory name.
#: includes/StagingBootstrapCheck.php:366
#, php-format
msgid "The theme \"%s\" caused a fatal error while loading WordPress. Deactivate it, or deactivate third-party plugins and switch to a default theme such as Twenty Twenty-Five, then try again."
msgstr "O tema \"%s\" causou um erro fatal ao carregar o WordPress. Desative ou desative plugins de terceiros e mude para um tema padrão como Twenty Twenty-Five, então tente novamente."

#. translators: %s: theme directory name.
#: includes/StagingBootstrapCheck.php:326
#, php-format
msgid "The theme \"%s\" has a code conflict (Cannot redeclare). Deactivate it, then try again."
msgstr "O tema \"%s\" tem um conflito de código (Não é possível redeclarar). Desative e tente novamente."

#. translators: %s: theme directory name.
#: includes/StagingBootstrapCheck.php:287
#, php-format
msgid "The theme \"%s\" is not compatible with PHP 8 because it uses create_function(), which was removed. Deactivate it, then try again."
msgstr "O tema \"%s\" não é compatível com PHP 8 porque usa create_function(), que foi removido. Desabilite-o e tente novamente."

#: build/staging/bundle.js:1
msgid "This will deploy staging to production and overwrite current production site. Are you sure you want to proceed?"
msgstr "Isso implantará o ambiente de testes na produção e substituirá o site de produção atual. Tem certeza de que deseja continuar?"

#: build/staging/bundle.js:1
msgid "This will navigate you to the production environment"
msgstr "Isso o levará para o ambiente de produção"

#: build/staging/bundle.js:1
msgid "This will navigate you to the staging environment"
msgstr "Isso o levará para o ambiente de testes"

#: build/staging/bundle.js:1
msgid "This will overwrite anything in staging and update it to an exact clone of the current production site. Are you sure you want to proceed?"
msgstr "Isso substituirá tudo no ambiente de testes e o atualizará como uma cópia exata do site de produção atual. Tem certeza de que deseja continuar?"

#: build/staging/bundle.js:1
msgid "This will permanently delete staging site. Are you sure you want to proceed? You can recreate another staging site at any time, but any specific changes you've made to this staging site will be lost."
msgstr "Isso excluirá permanentemente o site de testes. Tem certeza de que deseja continuar? Você pode recriar outro site de testes a qualquer momento, mas quaisquer alterações específicas feitas neste site serão perdidas."

#: includes/Staging.php:839
msgid "Unable to create the deployment lock directory."
msgstr "Não foi possível criar o diretório de bloqueio de implantação."

#: includes/Staging.php:1733
msgid "Unable to execute script (disabled_function)."
msgstr "Não foi possível executar o script (função desabilitada)."

#: includes/Staging.php:1757
msgid "Unable to execute script (permission error)."
msgstr "Não foi possível executar o script (erro de permissão)."

#: includes/Staging.php:1750
msgid "Unable to initialize WP Filesystem."
msgstr "Não é possível inicializar o WP Filesystem."

#: includes/Staging.php:847
msgid "Unable to open the deployment lock file."
msgstr "Não foi possível abrir o arquivo de bloqueio de implantação."

#: includes/Staging.php:1208
msgid "Unable to start the deployment process."
msgstr "Não foi possível iniciar o processo de implantação."

#: includes/Staging.php:1808
msgid "Unable to store the staging authentication token. A persistent object cache may be out of sync with the database, or the database is not accepting writes."
msgstr "Não é possível armazenar o token de autenticação de staging. Um cache de objetos persistente pode estar fora de sincronia com o banco de dados, ou o banco de dados não está aceitando escritas."

#: includes/Staging.php:644
msgid "Unsupported content copy type."
msgstr "Tipo de texto de conteúdo não suportado."

#: includes/StagingBootstrapCheck.php:358
msgid "WordPress could not start because of a fatal error in a plugin or theme. Deactivate third-party plugins and switch to a default theme such as Twenty Twenty-Five, then try again."
msgstr "O WordPress não conseguiu iniciar por causa de um erro fatal em um plugin ou tema. Desative plugins de terceiros e mude para um tema padrão como o Twenty Twenty-Five, então tente novamente."

#: build/staging/bundle.js:1
msgid "Working…"
msgstr "Trabalhando..."

