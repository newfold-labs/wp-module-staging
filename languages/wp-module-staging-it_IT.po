#: includes/Staging.php:370
msgid "Cloning can only be done from the production environment."
msgstr "La clonazione può essere fatta solo dall'ambiente di produzione."

#: includes/Staging.php:400
msgid "Staging environment already exists!"
msgstr "L'ambiente di preproduzione esiste già!"

#: includes/Staging.php:508
msgid "Unable to create the deployment lock directory."
msgstr "Impossibile creare la directory del blocco di deployment."

#: includes/Staging.php:516
msgid "Unable to open the deployment lock file."
msgstr "Impossibile aprire il file di blocco di deployment."

#: includes/Staging.php:664
msgid "Deployment failed. Check the staging log for details."
msgstr "Dispiegamento fallito. Controlla il registro di staging per i dettagli."

#: includes/Staging.php:705
msgid "Files deployed successfully."
msgstr "I file sono stati distribuiti con successo."

#: includes/Staging.php:706
msgid "Database deployed successfully."
msgstr "Database distribuito con successo."

#: includes/Staging.php:707
msgid "Files and Database deployed successfully."
msgstr "File e database distribuiti con successo."

#: includes/Staging.php:710
msgid "Deployment completed successfully."
msgstr "Spostamento completato con successo."

#: includes/Staging.php:750
#: includes/Staging.php:768
#: includes/Staging.php:797
#: includes/Staging.php:826
#: includes/Staging.php:1412
#: includes/Staging.php:1423
msgid "Deployment in progress. This may take several minutes."
msgstr "Dispiegamento in corso. Potrebbe richiedere diversi minuti."

#: includes/Staging.php:759
msgid "The deployment stopped before it completed. Please try again."
msgstr "Il dispiegamento si è fermato prima di essere completato. Per favore, riprova."

#: includes/Staging.php:868
msgid "Unable to start the deployment process."
msgstr "Impossibile avviare il processo di deployment."

#: includes/Staging.php:1113
msgid "The deployment is still running. Please wait and check again shortly."
msgstr "Il dispiegamento è ancora in corso. Attendete e controllate di nuovo a breve."

#: includes/Staging.php:1118
msgid "Something gone wrong, please get in touch with our support."
msgstr "Qualcosa è andato storto, per favore contattate il nostro supporto."

#: includes/Staging.php:1128
msgid "The staging operation did not complete, please get in touch with our support."
msgstr "L'operazione di preparazione non è stata completata, vi preghiamo di contattare il nostro supporto."

#: includes/Staging.php:1152
msgid "You must switch to the production environment before destroying staging."
msgstr "Devi passare all'ambiente di produzione prima di eliminare la preproduzione."

#: includes/Staging.php:1174
msgid "Switch to an environment you are already in, you cannot."
msgstr "Passa a un ambiente in cui sei già, non puoi."

#: includes/Staging.php:1291
msgid "Invalid staging CLI command."
msgstr "Comando CLI di preproduzione non valido."

#. translators: Invalid character that was entered
#: includes/Staging.php:1358
#, php-format
msgid "Invalid character (%s) in command."
msgstr "Carattere non valido (%s) nel comando."

#: includes/Staging.php:1367
msgid "Unable to execute script (disabled_function)."
msgstr "Impossibile eseguire lo script (disabled_function)."

#: includes/Staging.php:1380
msgid "Filesystem credentials required."
msgstr "Credenziali del file system richieste."

#: includes/Staging.php:1384
msgid "Unable to initialize WP Filesystem."
msgstr "Impossibile inizializzare il file system WP."

#: includes/Staging.php:1391
msgid "Unable to execute script (permission error)."
msgstr "Impossibile eseguire lo script (errore di autorizzazione)."

#: includes/Staging.php:1429
msgid "A deployment is currently in progress. Please wait for it to finish."
msgstr "È attualmente in corso una missione. Attendete che finisca."

#: includes/Staging.php:1442
msgid "Unable to store the staging authentication token. A persistent object cache may be out of sync with the database, or the database is not accepting writes."
msgstr "Impossibile memorizzare il token di autenticazione staging. Una cache di oggetti persistente potrebbe essere fuori sincronia con il database, oppure il database non accetta scritture."

